# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Project outputs (large trace files, runtime artifacts)
# Tracked reference traces are unaffected by these ignore rules
outputs/traces/**/*.json
outputs/traces/*.html
outputs/traces/checkpoint.pt
outputs/traces/merged_*.json
*.pt
*.pth

# Generated/exported model artifacts (too large for git)
models

# Runtime logs
logs/
log/

# Generated comparison reports
outputs/traces/ocs_comparison/

# Generated outputs
outputs/preset_plan.json
outputs/diagrams/

# Placement caches: rebuildable npz from the placement generators; the JSON
# results next to them are tracked, and a cache miss just costs build time.
outputs/four_cell/cache_*/
outputs/four_cell/*.quick.json

# Virtual environments
venv/
.venv/
.env

# Claude Code
.claude/

# Pre-merge history archive (moe_mlx_learning git bundle)
*.bundle

# Local AI tool session state (not repo content)
.codewhale/
outputs/ocs_model_comparison_traces/

# npm cache used by local tooling
.npmcache2/

# ASTRA-sim generated traffic traces (.et) are rebuilt from the source
# workload by the astra_sim bridge; the summary JSONs beside them are tracked.
outputs/astra_sim/et/

# Bulk instrument output: raw per-run event streams, per-interval CSVs and the
# regenerated figures. One command reproduces every one of them, and they are
# megabytes of rows nobody reads (inference_net_trace.py's <tag>.gpu.csv is a
# change log, spine_probe.py's *.messages.csv is a message list). The aggregate
# JSON beside them is the tracked evidence a document quotes:
#   outputs/net/inference_net_summary.json, sigma_sweep.json
#   outputs/net_status*/gpu_state_summary.json
#   outputs/spine/timeline_summary.json, astra_spine.*.json
outputs/net/*.csv
outputs/net/*.png
outputs/net_status*/*.csv
outputs/net_status*/raw/
outputs/spine/*.csv
outputs/spine/*.links.json
outputs/spine/*.tiers.json
outputs/spine/*.png
